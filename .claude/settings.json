{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git config user.name *)",
      "Bash(git config user.email *)",
      "Bash(chmod 600 .deploy-key)",
      "Bash(git config core.sshCommand *)",
      "Bash(git init -b main)",
      "Bash(git remote add origin *)",
      "Bash(git fetch origin main)",
      "Bash(git reset origin/main)",
      "Bash(git branch --set-upstream-to=origin/main)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.deploy-key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)"
    ]
  }
}
